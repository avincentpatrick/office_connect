# Office-Connect — local dev environment (template; copy to .env)
#
# Ports are chosen to COEXIST with the Laragon `dev_pims` stack already on this
# machine (Apache 80/443, MySQL 3306, `php artisan serve` 8000, Vite 5173).
# Do not reuse those numbers here.

APP_ENV=local
APP_PORT=8001
VITE_PORT=5174
BASE_URL=http://localhost:8001
# Frontend dev server (compose `web` service) proxies /api to the app container.
# Only set this when running Vite on the HOST instead (needs Node 22):
# VITE_API_PROXY_TARGET=http://localhost:8001

# --- PostgreSQL (runs in the `db` container) ---
# Two roles (database-standards.md §8):
#   oc_dev = OWNER role — runs Alembic migrations, owns the schema.
#   oc_app = RUNTIME role — created by migration 0001; SELECT/INSERT/UPDATE
#            only, NO DELETE anywhere, no UPDATE on append-only tables.
POSTGRES_USER=oc_dev
POSTGRES_PASSWORD=change-me
POSTGRES_DB=office_connect
OC_APP_PASSWORD=change-me-too

# NOTE: inside Docker these two URLs are DERIVED by docker-compose.yml from
# POSTGRES_*/OC_APP_PASSWORD above (real env vars outrank this file) — the
# lines below matter only for host-side runs/tools. Keep passwords in sync
# with the variables above. Changing OC_APP_PASSWORD after migration 0001 has
# run requires a manual `ALTER ROLE oc_app WITH PASSWORD ...` (or a fresh DB).
DATABASE_URL=postgresql+asyncpg://oc_app:change-me-too@db:5432/office_connect
# Alembic and privileged test fixtures use the OWNER role:
MIGRATION_DATABASE_URL=postgresql+asyncpg://oc_dev:change-me@db:5432/office_connect
# From the Windows HOST (e.g. a DB GUI): postgresql://oc_dev:change-me@localhost:5432/office_connect

# --- Redis (runs in the `redis` container) ---
# From the app CONTAINER: service name `redis`, container port 6379.
REDIS_URL=redis://redis:6379/0
# From the Windows HOST: redis://localhost:6380/0   (host 6380 avoids Laragon's 6379)

# HMAC session secret (reserved for the double-submit CSRF upgrade). Dev value only.
SESSION_SECRET=change-me

# --- Auth / sessions (Stage B / Increment 2) ---
# Server-side sessions live on Redis logical db 4 (db 0=config cache, 1/2=Celery,
# 3=GlitchTip). Override the whole URL with SESSION_REDIS_URL if needed.
# SESSION_REDIS_DB=4
# SESSION_REDIS_URL=
# The session cookie is HttpOnly + SameSite=Lax always; Secure is auto-on unless
# APP_ENV=local. For local HTTP dev you can force it off:
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_NAME=oc_session
# Server-enforced lifetimes (seconds): 12h absolute; 30-min idle for privileged
# roles, 60-min for staff; 5-min reauth window; 3 concurrent sessions.
# SESSION_ABSOLUTE_SECONDS=43200
# SESSION_IDLE_PRIVILEGED_SECONDS=1800
# SESSION_IDLE_STAFF_SECONDS=3600
# SESSION_MAX_CONCURRENT=3
# Throttle-not-lockout: backoff after 5 failures, ceiling 5 min, 15-min window.
# THROTTLE_THRESHOLD=5
# Custom-header CSRF: the header the SPA fetch wrapper must send on non-GET calls.
# CSRF_HEADER_NAME=X-Requested-With
# TOTP MFA (required for system_admin/approver). MFA_ISSUER names the authenticator entry.
# MFA_ISSUER=Office-Connect

# --- Storage driver (Increment 3) ---
# local  = content-addressed volume store (prod default; on-prem posture).
# gdrive = Google Drive (needs GOOGLE_CREDENTIALS_PATH + GDRIVE_FOLDER_ID).
STORAGE_DRIVER=local
STORAGE_DIR=/app/storage
# GDRIVE_FOLDER_ID=            # a Shared Drive folder id (driver verifies it)

# --- Email driver (Increment 3) ---
# Unset EMAIL_DRIVER = auto: 'smtp' if SMTP_HOST is set, else 'log' (dev
# fail-safe — logs the message instead of sending). Explicit: smtp | gmail | log.
# EMAIL_DRIVER=
# GMAIL_SENDER=                # delegated sender for the Gmail API driver

# --- Google service-account credentials (storage + email; Increment 3) ---
# GOOGLE_CREDENTIALS_PATH=path/to/service-account.json

# --- SMTP (Increment 3) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@blhsd.doh.gov.ph

# --- Attachments + malware scan (Increment 4) ---
# Empty CLAMAV_HOST -> NullScanner (dev = clean, prod = error/deny). To scan for
# real: `CLAMAV_HOST=clamav docker compose --profile clamav up -d`.
# ATTACHMENT_SCANNER=          # 'clamav' | 'null' (default: auto from CLAMAV_HOST)
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# ATTACHMENT_MAX_BYTES=20971520   # 20 MiB

# --- Notifications outbox (Increment 4) ---
# 'inline' = dispatch in-process (CLI/tests default); 'celery' = enqueue to the
# worker after commit (the running app default, set in docker-compose.yml).
# NOTIFICATIONS_DISPATCH=celery

# --- Observability (Increment 4) ---
LOG_JSON=true
# LOG_LEVEL=INFO
# SENTRY_DSN=                  # set to a GlitchTip project DSN to enable tracking
#   (run the tracker with: docker compose --profile observability up -d)
